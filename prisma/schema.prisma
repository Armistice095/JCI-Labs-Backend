// JCI Comé Labs — Module Événements & Billetterie
// Source de vérité du schéma. Les contraintes avancées (CHECK, index partiels, RLS)
// sont dans prisma/migrations_sql/0002_hardening.sql.
// NB : adapter le bloc datasource si la version de Prisma installée l'exige
// (Prisma 7 déplace les URL dans prisma.config.ts).

generator client {
  provider   = "prisma-client-js"
  engineType = "client" // sans moteur Rust : requêtes via @prisma/adapter-pg (image Docker plus légère)
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler Supabase (transaction mode, ?pgbouncer=true)
  directUrl = env("DIRECT_URL")   // connexion directe : migrations
}

// ───────────────────────── Enums ─────────────────────────

enum ProfileStatus {
  ACTIVE
  DISABLED
  @@map("profile_status")
}

enum RoleEventScope {
  ALL_EVENTS        // un grant global donne accès à tous les événements
  OWN_OR_ASSIGNED   // un grant global ne donne accès qu'aux événements créés ou assignés
  @@map("role_event_scope")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
  @@map("event_status")
}

enum EventCategory {
  CONFERENCE
  FORMATION
  ATELIER
  NETWORKING
  GALA
  AUTRE
  @@map("event_category")
}

enum OrderChannel {
  ONLINE
  PHYSICAL
  @@map("order_channel")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_IN_PROGRESS
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
  REFUND_REQUIRED // argent reçu mais place impossible à garantir (paiement tardif sans stock) : remboursement manuel
  @@map("order_status")
}

enum PaymentProvider {
  FEDAPAY
  PHYSICAL
  @@map("payment_provider")
}

enum PaymentMethod {
  MOBILE_MONEY_MTN
  MOBILE_MONEY_MOOV
  MOBILE_MONEY_OTHER
  CARD
  CASH
  MOBILE_MONEY_DIRECT // Mobile Money remis directement au vendeur
  UNKNOWN             // FedaPay n'a pas (encore) précisé le moyen
  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  REFUND_REQUIRED // argent reçu à rembourser : doublon, montant différent ou paiement tardif sans stock
  @@map("payment_status")
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
  @@map("ticket_status")
}

enum ScanResult {
  VALID
  ALREADY_USED
  INVALID
  CANCELLED
  REFUNDED
  PAYMENT_NOT_CONFIRMED
  WRONG_EVENT
  EVENT_NOT_ACTIVE
  MANUAL_ADMIT
  @@map("scan_result")
}

enum FileKind {
  TICKET_PDF
  TICKET_IMAGE
  SHARE_VISUAL
  EXPORT
  @@map("file_kind")
}

enum ExportType {
  PARTICIPANTS
  TICKETING_REPORT
  ATTENDANCE
  PAYMENTS_JOURNAL
  @@map("export_type")
}

enum ExportFormat {
  PDF
  CSV
  XLSX
  @@map("export_format")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  @@map("job_status")
}

enum EmailTemplate {
  TICKET_CONFIRMATION
  TICKET_RESEND
  @@map("email_template")
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  DEFERRED
  SOFT_BOUNCE
  HARD_BOUNCE
  BLOCKED
  SPAM
  FAILED
  @@map("email_status")
}

// ───────────────────── Identité & droits ─────────────────────
// profiles.id = auth.users.id (Supabase Auth). FK ajoutée en SQL (schéma auth hors Prisma).

model Profile {
  id          String        @id @db.Uuid
  email       String        @unique
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  phone       String?
  status      ProfileStatus @default(ACTIVE)
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]       @relation("UserRoleUser")
  grantedRoles    UserRole[]       @relation("UserRoleGranter")
  eventsCreated   Event[]          @relation("EventCreator")
  ordersSold      Order[]          @relation("OrderSeller")
  paymentsHandled Payment[]        @relation("PaymentReceiver")
  ticketsScanned  Ticket[]         @relation("TicketCheckedInBy")
  ticketsCanceled Ticket[]         @relation("TicketCancelledBy")
  scans           CheckinAttempt[]
  exportJobs      ExportJob[]
  auditLogs       AuditLog[]

  @@map("profiles")
}

model Role {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String         @unique // ADMIN, PRESIDENT, ORGANIZER, SELLER, GATE_AGENT
  name       String
  eventScope RoleEventScope @default(ALL_EVENTS) @map("event_scope")
  isSystem   Boolean        @default(true) @map("is_system")

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String // ex. "event.publish"

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid // null = global, sinon limité à cet événement
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    Profile  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  granter Profile? @relation("UserRoleGranter", fields: [grantedBy], references: [id], onDelete: SetNull)
  role    Role     @relation(fields: [roleId], references: [id])
  event   Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@map("user_roles")
}

// ───────────────────────── Événements ─────────────────────────

model Event {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String        @unique
  title       String
  category    EventCategory @default(CONFERENCE)
  description String        @default("")
  status      EventStatus   @default(DRAFT)

  // Nullables : un brouillon peut être enregistré incomplet (contrôlé strictement à la publication)
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  venueName String    @default("") @map("venue_name")
  city      String    @default("")

  // Billetterie (paramètres 1-1 avec l'événement)
  salesOpensAt        DateTime? @map("sales_opens_at") @db.Timestamptz(6)
  salesClosesAt       DateTime? @map("sales_closes_at") @db.Timestamptz(6) // par défaut : veille 18h00, calculée à la création
  salesManuallyClosed Boolean   @default(false) @map("sales_manually_closed")
  maxPerOrder         Int       @default(5) @map("max_per_order")

  // Identité visuelle du billet (décision 5 : modèle unique + couleur d'accent)
  accentColor  String? @map("accent_color") // #RRGGBB
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  // Textes de la page publique (sections repliables « Informations ») : une section sans texte n'est pas affichée
  practicalInfo String? @map("practical_info") // Infos pratiques (accès, parking, horaires d'ouverture des portes…)
  ticketTerms   String? @map("ticket_terms")   // Conditions d'utilisation du billet
  refundPolicy  String? @map("refund_policy")  // Annulation et remboursement

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?  @map("cancel_reason")

  createdBy Profile @relation("EventCreator", fields: [createdById], references: [id])

  posters    EventPoster[]
  organizers EventOrganizer[]
  programme  EventProgramItem[]
  categories TicketCategory[]
  orders     Order[]
  tickets    Ticket[]
  views      EventViewDaily[]
  scans      CheckinAttempt[]
  userRoles  UserRole[]
  exportJobs ExportJob[]
  files      GeneratedFile[]

  @@index([status, startsAt])
  @@map("events")
}

model EventPoster {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  storagePath String  @map("storage_path") // bucket public "event-posters"
  sharePath   String? @map("share_path") // variante légère 1200×630 (JPEG) pour l'aperçu des liens partagés ; null = pas encore générée
  mime        String
  sizeBytes   Int     @map("size_bytes")
  width       Int?
  height      Int?
  position    Int     @default(0)
  isCover     Boolean @default(false) @map("is_cover")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("event_posters")
}

model EventOrganizer {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  name        String
  description String?
  position    Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_organizers")
}

model EventProgramItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  time     String @db.VarChar(5) // "HH:mm" (heure locale de l'événement)
  label    String
  position Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("event_programme_items")
}

// Compteur de vues agrégé par jour (évite une ligne par visite)
model EventViewDaily {
  eventId String   @map("event_id") @db.Uuid
  day     DateTime @db.Date
  views   Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, day])
  @@map("event_view_daily")
}

// ───────────────────────── Billetterie ─────────────────────────

model TicketCategory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  name          String
  conditions    String?   // texte libre, ex. "Justificatif demandé" (aucune logique associée)
  priceXof      Int       @map("price_xof") // entier ; 0 interdit en v1 (règle applicative)
  quota         Int
  soldCount     Int       @default(0) @map("sold_count")
  reservedCount Int       @default(0) @map("reserved_count")
  saleStartsAt  DateTime? @map("sale_starts_at") @db.Timestamptz(6) // null = fenêtre de l'événement
  saleEndsAt    DateTime? @map("sale_ends_at") @db.Timestamptz(6)
  maxPerOrder   Int?      @map("max_per_order") // null = valeur de l'événement
  isActive      Boolean   @default(true) @map("is_active")
  position      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@unique([eventId, name])
  @@index([eventId, position])
  @@map("ticket_categories")
}

// ───────────────────────── Commandes & paiements ─────────────────────────

model Order {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference      String       @unique // CMD-2400
  eventId        String       @map("event_id") @db.Uuid
  channel        OrderChannel
  status         OrderStatus  @default(PENDING_PAYMENT)
  buyerFirstName String       @map("buyer_first_name")
  buyerLastName  String       @map("buyer_last_name")
  buyerEmail     String?      @map("buyer_email")
  buyerPhone     String?      @map("buyer_phone") // E.164
  totalXof       Int          @map("total_xof")
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz(6) // fin de réservation (en ligne)
  reservationHeld Boolean     @default(false) @map("reservation_held") // true tant que les places sont réservées (reserved_count)
  sendTicketsEmail Boolean    @default(true) @map("send_tickets_email") // envoyer les billets par e-mail (faux : vente physique sans e-mail demandé)
  paidAt         DateTime?    @map("paid_at") @db.Timestamptz(6)
  soldById       String?      @map("sold_by_id") @db.Uuid // vendeur (vente physique)
  idempotencyKey String?      @unique @map("idempotency_key")
  accessToken    String?      @unique @map("access_token") // suivi de commande côté acheteur, sans compte
  cancelledAt    DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?      @map("cancel_reason")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  event    Event       @relation(fields: [eventId], references: [id])
  soldBy   Profile?    @relation("OrderSeller", fields: [soldById], references: [id])
  items    OrderItem[]
  payments Payment[]
  tickets  Ticket[]
  emails   EmailLog[]

  @@index([eventId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String @map("order_id") @db.Uuid
  categoryId   String @map("category_id") @db.Uuid
  quantity     Int
  unitPriceXof Int    @map("unit_price_xof") // prix figé au moment de la commande

  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category TicketCategory @relation(fields: [categoryId], references: [id])
  tickets  Ticket[]

  @@index([orderId])
  @@map("order_items")
}

// Billets nominatifs « en attente » : on mémorise les bénéficiaires dès la commande
// pour émettre les billets à la confirmation sans redemander les infos.
model OrderHolder {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  itemId    String  @map("item_id") @db.Uuid
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String?
  phone     String?

  @@index([orderId])
  @@map("order_holders")
}

model Payment {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String          @map("order_id") @db.Uuid
  provider              PaymentProvider
  method                PaymentMethod   @default(UNKNOWN)
  status                PaymentStatus   @default(PENDING)
  expectedAmountXof     Int             @map("expected_amount_xof")
  confirmedAmountXof    Int?            @map("confirmed_amount_xof")
  providerTransactionId String?         @unique @map("provider_transaction_id") // FedaPay
  providerReference     String?         @map("provider_reference")              // ex. FP-41820 / réf. Mobile Money direct
  checkoutUrl           String?         @map("checkout_url")
  failureReason         String?         @map("failure_reason")
  receivedById          String?         @map("received_by_id") @db.Uuid // vendeur ayant encaissé
  confirmedAt           DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  order      Order          @relation(fields: [orderId], references: [id])
  receivedBy Profile?       @relation("PaymentReceiver", fields: [receivedById], references: [id])
  events     PaymentEvent[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}

// Journal brut des webhooks : l'unicité (provider, provider_event_id) garantit l'idempotence.
model PaymentEvent {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        PaymentProvider
  providerEventId String          @map("provider_event_id")
  type            String
  paymentId       String?         @map("payment_id") @db.Uuid
  payload         Json
  signatureValid  Boolean         @map("signature_valid")
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(6)
  processingError String?         @map("processing_error")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

// ───────────────────────── Billets & présences ─────────────────────────

model Ticket {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          String       @unique // JCI-2026-000001
  qrToken         String       @unique @map("qr_token") // 128 bits aléatoires, base64url
  eventId         String       @map("event_id") @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  orderItemId     String       @map("order_item_id") @db.Uuid
  categoryId      String       @map("category_id") @db.Uuid
  holderFirstName String       @map("holder_first_name")
  holderLastName  String       @map("holder_last_name")
  holderEmail     String?      @map("holder_email")
  holderPhone     String?      @map("holder_phone")
  status          TicketStatus @default(VALID)
  issuedAt        DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  checkedInAt     DateTime?    @map("checked_in_at") @db.Timestamptz(6)
  checkedInById   String?      @map("checked_in_by_id") @db.Uuid
  cancelledAt     DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  cancelledById   String?      @map("cancelled_by_id") @db.Uuid
  cancelReason    String?      @map("cancel_reason")

  event       Event          @relation(fields: [eventId], references: [id])
  order       Order          @relation(fields: [orderId], references: [id])
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id])
  category    TicketCategory @relation(fields: [categoryId], references: [id])
  checkedInBy Profile?       @relation("TicketCheckedInBy", fields: [checkedInById], references: [id])
  cancelledBy Profile?       @relation("TicketCancelledBy", fields: [cancelledById], references: [id])
  files       GeneratedFile[]
  emails      EmailLog[]
  scans       CheckinAttempt[]

  @@index([eventId, status])
  @@index([orderId])
  @@index([eventId, holderLastName, holderFirstName])
  @@map("tickets")
}

// Chaque scan est journalisé (succès ou non) : alimente l'onglet « Présences » et les anomalies.
model CheckinAttempt {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  ticketId    String?    @map("ticket_id") @db.Uuid
  agentId     String     @map("agent_id") @db.Uuid
  result      ScanResult
  tokenHint   String?    @map("token_hint") // 6 premiers caractères du jeton scanné, jamais le jeton entier
  deviceId    String?    @map("device_id")
  appVersion  String?    @map("app_version")
  note        String?    // motif en cas de MANUAL_ADMIT
  idempotencyKey String? @unique @map("idempotency_key") // rejouer un scan (réseau coupé) ne compte jamais deux fois
  scannedAt   DateTime   @default(now()) @map("scanned_at") @db.Timestamptz(6)

  event  Event   @relation(fields: [eventId], references: [id])
  ticket Ticket? @relation(fields: [ticketId], references: [id])
  agent  Profile @relation(fields: [agentId], references: [id])

  @@index([eventId, scannedAt])
  @@index([ticketId])
  @@map("checkin_attempts")
}

// ───────────────────────── Fichiers, exports, e-mails ─────────────────────────

model GeneratedFile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            FileKind
  ticketId        String?  @map("ticket_id") @db.Uuid
  eventId         String?  @map("event_id") @db.Uuid
  bucket          String   // "tickets" ou "exports" (privés, URL signées)
  storagePath     String   @map("storage_path")
  mime            String
  sizeBytes       Int      @map("size_bytes")
  templateVersion Int      @default(1) @map("template_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id])

  @@unique([ticketId, kind, templateVersion])
  @@map("generated_files")
}

model ExportJob {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String?      @map("event_id") @db.Uuid
  type        ExportType
  format      ExportFormat
  filters     Json?
  status      JobStatus    @default(QUEUED)
  fileId      String?      @map("file_id") @db.Uuid
  error       String?
  requestedBy String       @map("requested_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt  DateTime?    @map("finished_at") @db.Timestamptz(6)

  event     Event?  @relation(fields: [eventId], references: [id])
  requester Profile @relation(fields: [requestedBy], references: [id])

  @@index([requestedBy, createdAt])
  @@map("export_jobs")
}

model EmailLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String?       @map("order_id") @db.Uuid
  ticketId       String?       @map("ticket_id") @db.Uuid
  template       EmailTemplate
  toEmail        String        @map("to_email")
  status         EmailStatus   @default(QUEUED)
  brevoMessageId String?       @map("brevo_message_id")
  attempt        Int           @default(1)
  error          String?
  sentAt         DateTime?     @map("sent_at") @db.Timestamptz(6)
  lastEventAt    DateTime?     @map("last_event_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order  Order?  @relation(fields: [orderId], references: [id])
  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@index([brevoMessageId])
  @@index([orderId])
  @@map("email_logs")
}

// ───────────────────────── Transverse ─────────────────────────

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   // ex. "ticket.cancel", "sale.create", "role.grant"
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Profile? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Numérotation sans trou ni doublon : INSERT … ON CONFLICT DO UPDATE … RETURNING (voir next_counter())
model Counter {
  key   String @id // "order", "ticket:2026"
  value BigInt @default(0)

  @@map("counters")
}

model AppSetting {
  key       String   @id // ex. "reservation_ttl_minutes", "org_contact_email"
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}
