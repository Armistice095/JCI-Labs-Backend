{
  "name": "jci-labs-backend",
  "version": "0.1.0",
  "private": true,
  "description": "JCI Comé Labs — API Événements & Billetterie",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:sql": "tsx scripts/apply-sql.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "start:worker": "node dist/worker.js",
    "dev:worker": "nest start --watch --entryFile worker",
    "fedapay:check": "tsx scripts/fedapay-sandbox-check.ts",
    "fedapay:webhook": "tsx scripts/fedapay-webhook-test.ts",
    "api:lint": "npx --yes @redocly/cli lint openapi.yaml",
    "api:docs": "npx --yes @redocly/cli build-docs openapi.yaml -o docs/api.html --title \"JCI Comé Labs — API\" --openapi.disableGoogleFont=true",
    "api:contract": "jest --config jest.e2e.config.js --runInBand",
    "ticket:preview": "tsx scripts/preview-ticket.ts",
    "report:preview": "tsx scripts/preview-reports.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "fastify": "5.11.3",
    "fontkit": "^2.0.4",
    "image-size": "^2.0.4",
    "jose": "^5.10.0",
    "mjml": "^4.18.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@sparticuz/chromium": "^153.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "src/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
