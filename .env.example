NODE_ENV=development
PORT=3000

# Supabase > Connect > chaînes de connexion (bouton « Connect » en haut du projet).
# ⚠ Hébergeur sans IPv6 (Render, la plupart des PaaS) : utiliser les adresses du POOLER (aws-…pooler.supabase.com).
#   L'adresse « directe » db.xxxx.supabase.co n'est joignable qu'en IPv6 sur le plan gratuit.
# Pooler mode « transaction » (port 6543) : l'API au quotidien.
DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Pooler mode « session » (port 5432, MÊME hôte) : migrations Prisma et file de tâches pg-boss.
DIRECT_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # SECRET : jamais dans un front ni dans l'app mobile
# Uniquement si le projet utilise encore l'ancien secret JWT symétrique (HS256).
# Avec les clés de signature asymétriques (par défaut sur les nouveaux projets), laisser vide.
SUPABASE_JWT_SECRET=

POSTER_BUCKET=event-posters          # bucket PUBLIC à créer dans Supabase Storage

PUBLIC_WEB_URL=http://localhost:5173 # page publique (liens partagés)
ORG_CONTACT_PHONE=                   # WhatsApp de la JCI (+229…) : bouton « Écrire sur WhatsApp » des événements sans numéro propre
ADMIN_WEB_URL=http://localhost:5174  # admin (redirection des e-mails d'invitation)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ───────── Tâches de fond (pg-boss) ─────────
# all = API + tâches dans le même processus (dev) ; api / worker = séparés (production : deux services Docker)
PROCESS_ROLE=all

# ───────── FedaPay (tableau de bord → Développeurs → Clés API et Webhooks) ─────────
FEDAPAY_ENV=sandbox                       # sandbox | live
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxx    # SECRET, jamais dans un front. Une clé live avec FEDAPAY_ENV=sandbox (ou l'inverse) est refusée au démarrage.
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxx # « secret de signature » affiché à la création du webhook
FEDAPAY_WEBHOOK_IPS=                      # optionnel : IP FedaPay autorisées, séparées par des virgules (défense en plus de la signature)
FEDAPAY_WEBHOOK_TOLERANCE_SECONDS=300

# ───────── Cloudflare Turnstile (obligatoire en production) ─────────
TURNSTILE_SECRET_KEY=                     # en recette : clé de test Cloudflare 1x0000000000000000000000000000000AA (laisse tout passer)

# ───────── Billets (PDF / image) et rapports PDF ─────────
TICKETS_BUCKET=tickets                    # bucket PRIVÉ à créer dans Supabase Storage (URL signées)
TICKET_QR_BASE_URL=                       # défaut : {PUBLIC_WEB_URL}/billet  → le QR encode {base}/{jeton}
# Chromium/Chrome : uniquement pour les rapports PDF de l'événement (pas pour les billets). Détecté automatiquement ; à préciser sinon :
CHROMIUM_PATH=                            # ex. C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMIUM_HEADLESS_SHELL=false
CHROMIUM_LOW_MEMORY=false                 # true sur un hébergement de 512 Mo (Render gratuit) : Chromium en un seul processus, éteint au repos

# ───────── E-mails (Brevo) ─────────
BREVO_API_KEY=                            # Brevo → SMTP & API → Clés API (obligatoire en production)
BREVO_SENDER_EMAIL=                       # expéditeur VÉRIFIÉ dans Brevo (domaine authentifié SPF/DKIM/DMARC)
BREVO_SENDER_NAME=JCI Comé Excellence
BREVO_WEBHOOK_TOKEN=                      # secret (16+ caractères) : à mettre aussi dans l'authentification du webhook Brevo
BREVO_WEBHOOK_IPS=                        # optionnel : IP de Brevo autorisées (voir l'aide Brevo), séparées par des virgules
EMAIL_LOGO_URL=                           # optionnel : le logo est sinon publié automatiquement dans le bucket public des affiches
